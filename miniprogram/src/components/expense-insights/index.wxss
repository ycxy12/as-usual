.insights {
  background: var(--rj-surface, #fffefa);
  border: 1rpx solid var(--rj-line, #e9e9e3);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}
.heading {
  font-size: 34rpx;
  font-weight: 600;
}
.hint {
  display: block;
  padding: 38rpx 0;
  color: var(--rj-muted, #7e827c);
  font-size: 25rpx;
}
.line {
  margin-top: 26rpx;
  font-size: 25rpx;
}
.pair {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.muted {
  color: var(--rj-muted, #7e827c);
}
.line progress {
  margin-top: 16rpx;
}
.divider {
  height: 1rpx;
  background: var(--rj-line, #e9e9e3);
  margin: 32rpx 0;
}
.month {
  margin-top: 26rpx;
  font-size: 25rpx;
}
