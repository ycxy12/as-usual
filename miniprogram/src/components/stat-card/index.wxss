.stat {
  background: var(--rj-surface, #fffefa);
  border: 1rpx solid var(--rj-line, #e9e9e3);
  border-radius: 32rpx;
  padding: 30rpx;
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.label {
  color: var(--rj-muted, #7e827c);
  font-size: 25rpx;
}
.value {
  font-size: 40rpx;
  font-weight: 650;
}
.hint {
  color: var(--rj-muted, #7e827c);
  font-size: 22rpx;
}
