.empty {
  min-height: 300rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.symbol {
  font-size: 54rpx;
  color: var(--rj-accent, #597763);
  margin-bottom: 16rpx;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
}
.detail {
  font-size: 24rpx;
  color: var(--rj-muted, #7e827c);
  line-height: 1.5;
  margin-top: 12rpx;
}
.action {
  min-height: 80rpx;
  padding: 0 40rpx;
  margin-top: 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rj-accent-light, #eaf0e9);
  color: var(--rj-accent, #597763);
}
