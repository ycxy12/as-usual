.cover {
  width: 100%;
  height: 500rpx;
  border-radius: 22rpx;
  margin-top: 24rpx;
}
.intro {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 34rpx 0;
}
.status {
  color: var(--rj-accent);
}
.stats {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
}
.stat {
  min-width: 180rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.stat-value {
  font-weight: 600;
  color: var(--rj-accent);
}
.section {
  margin: 28rpx 0;
}
.field-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--rj-line);
}
.field-value {
  max-width: 65%;
  text-align: right;
  overflow-wrap: anywhere;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 24rpx;
}
.tag {
  color: var(--rj-accent);
  background: var(--rj-accent-light);
  padding: 10rpx 16rpx;
  border-radius: 30rpx;
}
.action {
  text-align: center;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 40rpx;
}
.actions view {
  flex: 1;
  text-align: center;
}
.delete {
  color: var(--rj-danger);
  padding: 20rpx;
}
