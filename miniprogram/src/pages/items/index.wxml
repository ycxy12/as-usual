<view class="page">
  <view class="intro"
    ><text class="eyebrow">日常集 · 物品</text
    ><text class="h1">和拥有的东西好好相处。</text
    ><text class="muted">记住来处，也看见使用的日子。</text></view
  >
  <view wx:if="{{error}}" class="error" bindtap="load"
    >{{error}} · 点击重试</view
  >
  <view class="module card" bindtap="items">
    <view class="row"
      ><text class="section-title">个人物品</text
      ><text class="link">查看全部　›</text></view
    >
    <text class="muted">数码、家具、工具与值得留存的收藏</text>
    <view class="numbers"
      ><text>{{itemCount}} 件</text><text>当前估值 {{itemValue}}</text></view
    >
  </view>
  <view class="module card" bindtap="wardrobe">
    <view class="row"
      ><text class="section-title">我的衣柜</text
      ><text class="link">查看全部　›</text></view
    >
    <text class="muted">穿过的喜欢，也要记下来</text>
    <view class="numbers"
      ><text>{{wardrobeCount}} 件</text
      ><text>{{longUnworn}} 件久未穿</text></view
    >
  </view>
  <view class="quick-row"
    ><view class="button-primary" bindtap="addItem">＋ 添加物品</view
    ><view class="button-secondary" bindtap="addGarment"
      >＋ 添加衣物</view
    ></view
  >
  <view class="section"
    ><text class="section-title">最近整理</text
    ><view class="card recent">
      <empty-state
        wx:if="{{!error && !latest.length}}"
        title="还没有物品"
        detail="从身边的一件开始记录。"
      />
      <view
        wx:for="{{latest}}"
        wx:key="id"
        class="row recent-row"
        data-id="{{item.id}}"
        data-mode="{{item.mode}}"
        bindtap="open"
        ><text>{{item.name}}</text
        ><text class="muted">{{item.category}}　›</text></view
      >
    </view></view
  >
</view>
