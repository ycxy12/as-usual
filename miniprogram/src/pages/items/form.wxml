<view class="page">
  <view class="intro"
    ><text class="eyebrow"
      >物品 · {{mode==='wardrobe'?'我的衣柜':'个人物品'}}</text
    ><text class="h1">{{title}}</text></view
  >
  <view class="field"
    ><text class="field-label">名称 *</text
    ><input
      class="field-input"
      placeholder="这件东西叫什么？"
      value="{{name}}"
      data-field="name"
      bindinput="input"
  /></view>
  <view class="field"
    ><text class="field-label">图片</text
    ><image
      wx:if="{{imagePath}}"
      class="photo"
      src="{{imagePath}}"
      mode="aspectFill"
      bindtap="chooseImage"
    /><view wx:else class="image-picker" bindtap="chooseImage"
      >＋ 添加一张图片</view
    ><text wx:if="{{imagePath}}" class="link" bindtap="removeImage"
      >移除图片</text
    ></view
  >
  <view class="field"
    ><text class="field-label">分类 *</text
    ><picker
      range="{{categories}}"
      value="{{categoryIndex}}"
      data-field="category"
      bindchange="pick"
      ><view class="field-picker">{{category}}　⌄</view></picker
    ></view
  >
  <view class="field"
    ><text class="field-label">品牌</text
    ><input
      class="field-input"
      placeholder="选填"
      value="{{brand}}"
      data-field="brand"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='item'}}" class="field"
    ><text class="field-label">型号</text
    ><input
      class="field-input"
      placeholder="选填"
      value="{{model}}"
      data-field="model"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='wardrobe'}}" class="field"
    ><text class="field-label">颜色</text
    ><input
      class="field-input"
      placeholder="选填"
      value="{{color}}"
      data-field="color"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='wardrobe'}}" class="field"
    ><text class="field-label">尺码</text
    ><input
      class="field-input"
      placeholder="选填"
      value="{{size}}"
      data-field="size"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='wardrobe'}}" class="field"
    ><text class="field-label">季节</text
    ><picker
      range="{{seasons}}"
      value="{{seasonIndex}}"
      data-field="season"
      bindchange="pick"
      ><view class="field-picker">{{season || '未选择'}}　⌄</view></picker
    ></view
  >
  <view class="field"
    ><text class="field-label">购买日期</text
    ><view class="date-row"
      ><picker
        mode="date"
        end="{{today}}"
        value="{{purchaseDate || today}}"
        data-field="purchaseDate"
        bindchange="datePick"
        ><view class="field-picker"
          >{{purchaseDate || '选择日期'}}　⌄</view
        ></picker
      ><text
        wx:if="{{purchaseDate}}"
        class="link"
        data-field="purchaseDate"
        bindtap="clearDate"
        >清空</text
      ></view
    ></view
  >
  <view class="field"
    ><text class="field-label">购买价格（元）</text
    ><input
      class="field-input"
      type="digit"
      placeholder="选填"
      value="{{purchasePrice}}"
      data-field="purchasePrice"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='item'}}" class="field"
    ><text class="field-label">当前估值（元）</text
    ><input
      class="field-input"
      type="digit"
      placeholder="选填"
      value="{{currentValue}}"
      data-field="currentValue"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='item'}}" class="field"
    ><text class="field-label">保修截止日期</text
    ><view class="date-row"
      ><picker
        mode="date"
        value="{{warrantyUntil || today}}"
        data-field="warrantyUntil"
        bindchange="datePick"
        ><view class="field-picker"
          >{{warrantyUntil || '选择日期'}}　⌄</view
        ></picker
      ><text
        wx:if="{{warrantyUntil}}"
        class="link"
        data-field="warrantyUntil"
        bindtap="clearDate"
        >清空</text
      ></view
    ></view
  >
  <view wx:if="{{mode==='wardrobe'}}" class="field"
    ><text class="field-label">穿着次数</text
    ><input
      class="field-input"
      type="number"
      value="{{wearCount}}"
      data-field="wearCount"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='wardrobe'}}" class="field"
    ><text class="field-label">最近穿着日期</text
    ><view class="date-row"
      ><picker
        mode="date"
        end="{{today}}"
        value="{{lastWornDate || today}}"
        data-field="lastWornDate"
        bindchange="datePick"
        ><view class="field-picker"
          >{{lastWornDate || '选择日期'}}　⌄</view
        ></picker
      ><text
        wx:if="{{lastWornDate}}"
        class="link"
        data-field="lastWornDate"
        bindtap="clearDate"
        >清空</text
      ></view
    ></view
  >
  <view class="field"
    ><text class="field-label">状态</text
    ><picker
      range="{{statuses}}"
      value="{{statusIndex}}"
      data-field="status"
      bindchange="pick"
      ><view class="field-picker">{{status}}　⌄</view></picker
    ></view
  >
  <view wx:if="{{mode==='item'}}" class="field"
    ><text class="field-label">存放位置</text
    ><input
      class="field-input"
      placeholder="选填"
      value="{{storageLocation}}"
      data-field="storageLocation"
      bindinput="input"
  /></view>
  <view class="field"
    ><text class="field-label">标签</text
    ><input
      class="field-input"
      placeholder="用空格分隔，例如 常用 珍藏"
      value="{{tagsText}}"
      data-field="tagsText"
      bindinput="input"
  /></view>
  <view wx:if="{{mode==='item'}}" class="field"
    ><text class="field-label">备注</text
    ><textarea
      class="field-textarea"
      placeholder="关于它的故事……"
      value="{{note}}"
      data-field="note"
      bindinput="input"
    />
  </view>
  <view class="button-primary form-footer" bindtap="save"
    >{{saving?'保存中…':'保存'}}</view
  >
</view>
