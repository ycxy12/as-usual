.intro {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 40rpx 0 24rpx;
}
.filters-card {
  margin-bottom: 24rpx;
}
.switch-row {
  min-height: 80rpx;
}
.choose {
  margin-bottom: 28rpx;
}
.empty-result {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  text-align: center;
  padding: 60rpx 20rpx;
}
.result {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
}
.result-image {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
}
.result-name {
  font-size: 44rpx;
  font-weight: 650;
}
