.cover {
  width: 100%;
  height: 500rpx;
  border-radius: 22rpx;
  margin-top: 24rpx;
}
.intro {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 34rpx 0;
}
.detail {
  margin-bottom: 28rpx;
}
.field-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--rj-line);
  align-items: flex-start;
}
.field-value {
  max-width: 66%;
  text-align: right;
  overflow-wrap: anywhere;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 24rpx;
}
.tag {
  color: var(--rj-accent);
  background: var(--rj-accent-light);
  padding: 10rpx 16rpx;
  border-radius: 30rpx;
}
.visit {
  text-align: center;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 40rpx;
}
.actions view {
  flex: 1;
  text-align: center;
}
.delete {
  color: var(--rj-danger);
  padding: 20rpx;
}
