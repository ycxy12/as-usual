<view class="page">
  <view wx:if="{{error}}" class="error" bindtap="load"
    >{{error}} · 点击重试</view
  >
  <image wx:if="{{image}}" class="cover" src="{{image}}" mode="aspectFill" />
  <view class="intro"
    ><text class="eyebrow"
      >{{type==='place'?'周末去哪玩':'今天吃什么'}} · {{category}}</text
    ><text class="h1">{{name}}</text
    ><text class="muted">{{visits}} · {{lastVisit}}</text></view
  >
  <view class="card detail"
    ><view wx:for="{{fields}}" wx:key="label" class="row field-row"
      ><text class="muted">{{item.label}}</text
      ><text class="field-value">{{item.value}}</text></view
    ><view wx:if="{{tags.length}}" class="tags"
      ><text wx:for="{{tags}}" wx:for-item="tag" wx:key="*this" class="tag"
        >#{{tag}}</text
      ></view
    ></view
  >
  <view class="button-primary visit" bindtap="visit"
    >{{busy?'记录中…':action}}</view
  >
  <view class="actions"
    ><view class="button-secondary" bindtap="edit">编辑</view
    ><view class="delete" bindtap="remove">删除</view></view
  >
</view>
