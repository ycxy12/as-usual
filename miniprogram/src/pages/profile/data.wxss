.intro {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 40rpx 0 26rpx;
}
.data-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--rj-line);
}
.data-row:last-child {
  border: 0;
}
.notice {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  line-height: 1.7;
}
.danger-zone {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 56rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #ecd8d4;
}
.danger-button,
.clear-button {
  min-height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  background: var(--rj-danger);
}
.confirm-layer {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(20, 24, 21, 0.4);
  display: flex;
  align-items: flex-end;
}
.confirm-card {
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.confirm-actions {
  display: flex;
  gap: 16rpx;
}
.confirm-actions view {
  flex: 1;
}
