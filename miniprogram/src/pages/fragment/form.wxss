.date-row {
  display: flex;
  gap: 24rpx;
}
.date-row .field {
  flex: 1;
  min-width: 0;
}
.image-row {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
}
.image-wrap,
.add-image {
  width: 150rpx;
  height: 150rpx;
  position: relative;
  border-radius: 20rpx;
}
.image-wrap image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
.remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: var(--rj-danger, #ac5a50);
  color: white;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-image {
  border: 1rpx dashed #d5d8d0;
  background: var(--rj-surface, #fffefa);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rj-accent, #597763);
  font-size: 54rpx;
}
