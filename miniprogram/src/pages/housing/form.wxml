<view class="page">
  <view class="intro">
    <text class="eyebrow">居住成本</text>
    <text class="h1">把生活的开销记清楚</text>
  </view>
  <view class="field">
    <text class="field-label">费用分类 *</text>
    <picker
      range="{{categories}}"
      value="{{categoryIndex}}"
      bindchange="categoryChange"
    >
      <view class="field-picker">{{category}}　⌄</view>
    </picker>
  </view>
  <view class="field">
    <text class="field-label">发生日期</text>
    <picker mode="date" value="{{date}}" bindchange="dateChange">
      <view class="field-picker">{{date}}　⌄</view>
    </picker>
  </view>
  <view class="field">
    <text class="field-label">所属账期</text>
    <picker
      mode="date"
      fields="month"
      value="{{billingMonth}}"
      bindchange="monthChange"
    >
      <view class="field-picker">{{billingMonth}}　⌄</view>
    </picker>
  </view>
  <view class="field">
    <text class="field-label">金额（元）*</text>
    <input
      class="field-input"
      type="digit"
      placeholder="0.00"
      value="{{amount}}"
      data-field="amount"
      bindinput="input"
    />
  </view>
  <view class="field">
    <text class="field-label">备注</text>
    <textarea
      class="field-textarea"
      placeholder="例如：本月电费、维修说明……"
      value="{{note}}"
      data-field="note"
      bindinput="input"
    />
  </view>
  <view class="button-primary form-footer" bindtap="save">
    {{saving?'保存中…':'保存费用'}}
  </view>
</view>
