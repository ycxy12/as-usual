.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--rj-line, #e9e9e3);
  border-radius: 24rpx;
  background: var(--rj-surface, #fffefa);
}
.search text {
  font-size: 44rpx;
  color: var(--rj-muted, #7e827c);
}
.search input {
  flex: 1;
}
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 34rpx;
}
.name {
  font-size: 34rpx;
  font-weight: 600;
}
.totals {
  display: flex;
  gap: 36rpx;
  color: var(--rj-muted, #7e827c);
  margin-top: 22rpx;
  font-size: 25rpx;
}
