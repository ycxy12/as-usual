.hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 40rpx 0 10rpx;
}
.quick {
  margin-top: 32rpx;
}
.today-item {
  display: flex;
  gap: 24rpx;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--rj-line, #e9e9e3);
  align-items: flex-start;
}
.today-item:last-child {
  border-bottom: 0;
}
.time {
  font-size: 24rpx;
  color: var(--rj-muted, #7e827c);
  flex-shrink: 0;
  padding-top: 4rpx;
}
.content {
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.recent-detail {
  max-width: 55%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cost-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.cost {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.cost-value {
  font-size: 40rpx;
  font-weight: 600;
}
.gift-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
